*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}
html,
body{
    width: 100%;
    height: 100%;
}
body{
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: #f5f5ff;
}
.container{
    width: 100%;
    height: 100vh;
    display: flex;
    justify-content: flex-start;
    align-items: center;
}
.left-section{
    width: 70%;
    height: 100%;
    display: flex;
    justify-content: flex-start;
    align-items: stretch;
    background-color: linear-gradient(135deg,#0aa9f5, #08a1ed);
}
.left-section img{
    width: 84%;
    max-width: 800px;
    height: auto;
    background-position: cover;
}
.form-section{
    width: 50%;
    height: 100%;
    background-color: #f7fcff;
    display: flex;
    justify-content: center;
    align-items: center;
}
.login-form{
    width: min(82%,420px);
    display: flex;
    flex-direction: column;
    padding: 30px;
    gap: 0;
}
.login-form h1{
    margin: 0;
    color: #263746;
    font-size: 32px;
    font-weight: 700;
    text-align: center;
}
.subtitle{
    margin: 8px 0 30px;
    color: #71808d;
    font-size: 14px;
    text-align: center;
}
.field{
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.field +.field{
    margin-top: 18px;
}
label{
    color: #687783;
    font-size: 12px;
}
input{
    width: 100%;
    height: 48px;
    border: 0;
    border-radius: 9px;
    background-color: #ffffff;
    padding: 0 15px;
    color: #4c5b66;
    font-size: 13px;
    outline: none;
    box-shadow: 0 3px 12px rgba(40,100,130,0.05);
}
input::placeholder{
    color: #c7d0d7;
}
.forgot{
    align-self: flex-end;
    margin-top: 7px;
    color: #0f79cf;
    text-decoration: underline;
    font-size: 11px;
}
.login-button{
    width: 100%;
    height: 48px;
    border: 0;
    border-radius: 9px;
    background: linear-gradient(90deg, #08aaf5, #0aa5ef);
    color: #ffffff;
    font-size: 30px;
    cursor: pointer;
    margin-top: 20px;
    font-weight: bolder;
    box-shadow: 0 5px 12px rgba(8, 169, 244, 0.18);
}
.register{
    margin: 28px 0 0;
    text-align: center;
    color: #77848e;
    font-size: 11px;
}
.register a{
    color: #249ee5;
    text-decoration: none;
    font-weight: 600;
}
